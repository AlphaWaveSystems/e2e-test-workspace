# Run with -y (--yes): "clear app data" is a destructive operation, and the CLI refuses it without the flag.
# The run command in the repo-root README.md already passes -y.

test "restart app preserves state"
  @device @lifecycle
  restart the app
  wait 5 seconds
  see "FlutterProbe Test App"

test "clear app data resets everything"
  @device @lifecycle
  clear app data
  wait 5 seconds
  open the app
  wait 5 seconds
  see "FlutterProbe Test App"
